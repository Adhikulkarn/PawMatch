# PawMatch Production Environment Configuration
SECRET_KEY=production-secret-key-must-be-set-in-environment-vault
DEBUG=False
ALLOWED_HOSTS=.onrender.com,api.pawmatch.com

# Database (Production PostgreSQL Cluster)
DATABASE_URL=postgresql://neondb_owner:npg_EOCUgZ52XTcM@ep-cold-sunset-azn3x0as-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis Cache / Task Broker
REDIS_URL=redis://:prod_redis_password@prod-redis-host:6379/0

# Email Gateway Configuration
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=prod-email-api-key
DEFAULT_FROM_EMAIL=PawMatch <noreply@pawmatch.com>

# JWT Lifetimes
JWT_ACCESS_LIFETIME=15
JWT_REFRESH_LIFETIME=7

# Observability
LOG_LEVEL=WARNING

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=https://pawmatch.com,https://www.pawmatch.com
CSRF_TRUSTED_ORIGINS=https://pawmatch.com,https://www.pawmatch.com
SECURE_SSL_REDIRECT=True
