# PawMatch Staging Environment Configuration
SECRET_KEY=staging-secret-key-replace-with-vault-secret
DEBUG=False
ALLOWED_HOSTS=.onrender.com,staging-api.pawmatch.com

# Database (PostgreSQL Staging DB)
DATABASE_URL=postgres://pawmatch_staging_user:staging_password@staging-db-host:5432/pawmatch_staging_db

# Redis Cache / Task Broker
REDIS_URL=redis://:staging_redis_password@staging-redis-host:6379/0

# Email Gateway Configuration
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=staging-email-api-key
DEFAULT_FROM_EMAIL=PawMatch Staging <staging-noreply@pawmatch.com>

# JWT Lifetimes
JWT_ACCESS_LIFETIME=15
JWT_REFRESH_LIFETIME=7

# Observability
LOG_LEVEL=INFO

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=https://staging.pawmatch.com
CSRF_TRUSTED_ORIGINS=https://staging.pawmatch.com
SECURE_SSL_REDIRECT=True
