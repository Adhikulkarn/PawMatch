# PawMatch Development Environment Configuration
SECRET_KEY=django-insecure-dev-key-change-in-production-environments-12345
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*

# Database (Leave empty for SQLite fallback in dev)
DATABASE_URL=sqlite:///db.sqlite3

# Redis Cache (Optional for local dev)
REDIS_URL=redis://127.0.0.1:6379/0

# Email Gateway (Console backend used in dev)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PawMatch Dev <noreply@pawmatch.local>

# JWT Lifetimes (in minutes/days)
JWT_ACCESS_LIFETIME=60
JWT_REFRESH_LIFETIME=30

# Observability
LOG_LEVEL=DEBUG

# CORS & CSRF Defaults
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=False
