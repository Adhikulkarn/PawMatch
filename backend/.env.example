# ==============================================================================
# PawMatch Environment Variables Blueprint
# ==============================================================================
# Copy this file to .env, .env.development, .env.staging, or .env.production
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Framework & Core Settings
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL / SQLite fallback)
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Cache & Task Broker (Redis)
# Format: redis://:password@host:port/db
REDIS_URL=

# Email Gateway Configuration
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PawMatch <noreply@pawmatch.com>

# JWT Authentication Policy
JWT_ACCESS_LIFETIME=15
JWT_REFRESH_LIFETIME=7

# Observability & Logging
LOG_LEVEL=INFO

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
SECURE_SSL_REDIRECT=False
