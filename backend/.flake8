[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    migrations,
    build,
    dist

per-file-ignores =
    config/settings/development.py: F403, F405
    config/settings/staging.py: F403, F405
    config/settings/production.py: F403, F405
